{
  "name": "dsh-desktop-sider-glass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frosted-glass sidebar and title bar for the DeepSeek Harness desktop app",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Htonng/dsh-desktop-sider-glass.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "glassmorphism",
    "electron",
    "ui-plugin"
  ]
}
